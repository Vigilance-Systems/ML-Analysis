# Copy to server/.env (same folder as app.py) and fill in. NEVER commit the real .env.
# Where to find these: watsonx Orchestrate > profile icon > Settings > API details
#   -> "Service instance URL" and "Generate API key". Agent ID: see README section below.

WXO_API_KEY=paste-your-orchestrate-api-key-here
WXO_INSTANCE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<your-instance-id>
WXO_RISK_AGENT_ID=paste-the-risk_agent-id-here

# Optional: override the token endpoint if the auto-detected one is wrong for your account
# WXO_TOKEN_URL=https://iam.cloud.ibm.com/identity/token

# Existing MapShare settings
MAPSHARE_ID=MYLETTERCODE
# DEMO_MODE=1
